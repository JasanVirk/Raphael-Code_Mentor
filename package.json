{
  "name": "codementor",
  "displayName": "CodeMentor",
  "description": "AI-powered coding tutor for Java that guides students to understand errors",
  "version": "0.0.1",
  "publisher": "jasanvirk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JasanVirk/Raphael-Code_Mentor.git"
  },
  "keywords": [
    "java",
    "tutor",
    "education",
    "compiler",
    "ai",
    "gemini",
    "hints"
  ],
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Education",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codementor.explainError",
        "title": "CodeMentor: Explain Error",
        "category": "CodeMentor",
        "icon": "$(mortar-board)"
      },
      {
        "command": "codementor.giveHint",
        "title": "CodeMentor: Give Me a Hint",
        "category": "CodeMentor",
        "icon": "$(lightbulb)"
      },
      {
        "command": "codementor.tryAgain",
        "title": "CodeMentor: Try Again",
        "category": "CodeMentor",
        "icon": "$(refresh)"
      },
      {
        "command": "codementor.setApiKey",
        "title": "CodeMentor: Set API Key",
        "category": "CodeMentor",
        "icon": "$(key)"
      },
      {
        "command": "codementor.jumpToLine",
        "title": "CodeMentor: Jump to Line",
        "category": "CodeMentor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codementor.explainError",
          "when": "resourceExtname == .java",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "codementor.explainError",
          "when": "resourceExtname == .java",
          "group": "codementor@1"
        },
        {
          "command": "codementor.giveHint",
          "when": "resourceExtname == .java",
          "group": "codementor@2"
        },
        {
          "command": "codementor.tryAgain",
          "when": "resourceExtname == .java",
          "group": "codementor@3"
        }
      ],
      "view/title": [
        {
          "command": "codementor.explainError",
          "when": "view == codementor.tutorView",
          "group": "navigation"
        },
        {
          "command": "codementor.tryAgain",
          "when": "view == codementor.tutorView",
          "group": "navigation"
        },
        {
          "command": "codementor.setApiKey",
          "when": "view == codementor.tutorView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codementor-sidebar",
          "title": "CodeMentor",
          "icon": "$(mortar-board)"
        }
      ]
    },
    "views": {
      "codementor-sidebar": [
        {
          "type": "webview",
          "id": "codementor.tutorView",
          "name": "Tutor"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "vscode:package": "vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
